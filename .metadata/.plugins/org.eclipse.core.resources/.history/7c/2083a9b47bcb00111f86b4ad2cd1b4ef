
public class MainClass {
	public static void main(String[] args) {
		
		/*
		 * 지정자에 사용할 수 있는 옵션들
		 */
		
		//1. [.precision] : 소수점 아래 자리수를 지정
		float rate = 3.141592f;
		System.out.printf("rate: %f %n", rate));   //3.141592
		System.out.printf("rate: %.4f %n", rate)); //3.1416 <- 반올림 됨
		
		
		//2. [width] : 전체 출력 자리수 지정하고 오른쪽 정렬
		int num1 = 1;
		int num2 = 12;
		int num3 = 123;
		// 오른쪽 정렬
		System.out.printf("num1: %3d %n", num1);  // __1
		System.out.printf("num2: %3d %n", num2);  // _12
		System.out.printf("num3: %3d %n", num3);  // 123
		// 왼쪽 정렬
		System.out.printf("num1: %-3d %n", num1);  // 1__
		System.out.printf("num2: %-3d %n", num2);  // 12_
		System.out.printf("num3: %-3d %n", num3);  // 123
		
		
		//3. [flags] : 전체 출력 자리수가 지정된 경우 빈칸을 0으로 채운다. -> 오른쪽 정렬일 때만 적용됨.
		int num4 = 1;
		int num5 = 12;
		int num6 = 123;
		
		System.out.printf("num4: %04d %n", num4);  // 1__
		System.out.printf("num5: %04d %n", num5);  // 12_
		System.out.printf("num6: %04d %n", num6);  // 123
		
		
		//4. [argument_index$] : 데이터 적용 위치를 지정
		int num7 = 1;
		int num8 = 2;
		int num9 = 3;
		int num10 = 4;
		
		System.out.printf("num7: %4$d,num8: %3$d, num9: %2$d, num10: %1$d", num10, num9, num8, num7);
		
	}
}
