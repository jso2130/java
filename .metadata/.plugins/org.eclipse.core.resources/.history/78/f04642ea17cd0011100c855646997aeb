
public class Loop02ex {
	
	public static void main(String[] args) {
		
		/*
		 * 반복 흐름 제어
		 */
		
		/*
		 *  1. break
		 *  : 프로그램 실행 즉시 중단
		 */
		
		// 예제 ) 1 ~ 10까지 정수의 합을 구하되, 합이 30이 넘으면 중단
		
		int sum = 0;
		for (int i = 1; i <= 10; i++) {
			sum += 1;
			if (sum > 30)
				break;
		}
		
		System.out.println(sum);
		
		
		/*
		 *  2. continue
		 *  : 반복 실행 시 다음 반복문으로 넘어감
		 */
		
		
		
	}

}
