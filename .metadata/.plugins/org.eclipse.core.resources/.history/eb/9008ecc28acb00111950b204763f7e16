		String str1 = "Hello";
		String str2 = "World";
		
		System.out.println(str1+str2);
		
		// 1-3. 문자 덧셈(연결 연산자)
		System.out.println('A' + 'B');    // 결과 : 131 (유니코드 덧셈 결과) 
		
		
		// 비교연산자
		// 대입(복합)연산자
		
		
	}
