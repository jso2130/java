		/*
		 * 반복문 이름 부여하기
		 * 
		 * 지금까지 반복문의 다양한 기능에 대해서 살펴봤는데요, 
		 * 마지막으로 반복문에 이름을 부여하는 것에 대해서 살펴보겠습니다. 
		 * 반복문에 이름을 부여한다는 것은 for문 또는 while문에 명찰(Label)을 달아주는 것이라고 생각하면 됩니다. 
		 * 그리고 명찰뒤에 콜론(:)을 붙여 줍니다.
		 */
		
		// 예제 ) 구구단 출력 
		// 1. 짝수 구구단은 생략
		// 2. 모든 구구단 곱셈값 더하고 합이 200이 초과하면 출력 중단
		
		int sum = 0;
		for (int i = 2; i < 10; i++) {
			
			if (i % 2 == 0)
				continue;
			
			loopLabel2:   // 반복문 이름
			for (int j = 1; j < 10; j++) {
				
				if (i % 2 == 0)
					continue loopLabel2;
				
				sum += i * j;
				
				if (sum > 200)
					break;
				System.out.printf("%d * %d = %d \n", i, j, sum); 
			}
			
		}
		
	}

