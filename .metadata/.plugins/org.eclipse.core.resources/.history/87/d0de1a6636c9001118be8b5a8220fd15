
public class PrintFClass {

	public static void main(String[] args) {
		
		//형식 문자열 출력
		/*
		 * 특정 형식에 맞춰 출력해야 하는 경우 사용
		 * System.out.printf();
		 */
		
		String name = "jsy";
		System.out.printf("이름: %s", name);  // 콤마 다음 값을 $s(지정자)에 넣는다
		
		String userName = "정승윤";
		String userAddr = "대전";
		
		System.out.printf("\n이름: %s, 주소: $s", userName, userAddr);
		                  
		
	}
	
}
