
public class Operator4 {

	public static void main(String[] args) {
		
		/*
		 * 논리연산자(boolean)
		 * 1. && : and  -> 모든 값이 true일 경우에만 'true'
		 * 2. || : or   -> 하나의 값이라도 true이면 'true'
		 * 3. ! : not(부정 연산자)  -> 현재 상태를 부정. 반대값으로 (true >> false)
		 */
		
		int num1 = 10; 
		int num2 = 20;
		int num3 = 30;
		
		boolean result = (num1<num3) && (num2<num3); //true && true
		System.out.println(result);                  //true
		boolean result = (num1>num3) && (num2<num3); //false && true
		System.out.println(result);                  //false
		boolean result = (num1>num3) || (num2<num3); //false || true
		System.out.println(result);                  //true
		boolean result = (num1>num3) || (num2<num3); //false && true
		System.out.println(result);                  //true
		
		result = (num1<num2) && (num2<num3) && (num3>num1) 
				     // true && true
				                      // true && true   
		System.out.println(result);                  //true
		
		System.out.println(!true); //false
		System.out.println(!!true);  //true
		
		/*
       * &&와 ||중에서 어떤 연산자의 연산 우선순위가 높을까요?
       * 갑작스런 질문에 살짝 당황하셨나요? 
       * 쉽게 생각하면 &&와 ||는 모두 논리연산자로 연산 우선순위가 같아서 왼쪽부터 순차적으로 연산할거라 
       * 생각하기 쉽습니다. 하지만 실제 연산 우선순위는 &&가 ||보다 높습니다. 
       */
		
		boolean res = false;
		int no1 = 10;
		int no2 = 20;
		int no3 = 30;
		
		res = (no1 < no3) || ((no2 < no3) && (no1 > no3));
		                      // true && false = false
		       // true || false = true
		System.out.println(res);  //true
		
		
		/*
		 * 조건식 연산자 / 삼항식 연산자
		 * 
		 * 데이터 타입   변수명  =  (조건)  ?   true일 경우  :  false일 경우
		 */
		
		int passScore = 80;
		int myScore = 90;
		
		String resultStr = (myScore >= passScore) ? "PASS" : "FAIL"
		
	}
	
}
